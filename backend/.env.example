# ========================================================
# Project Manager - Backend Environment Variables
# Copy this file to backend/.env
# ========================================================

# Application Settings
PROJECT_NAME="Project Manager"
API_V1_STR="/api/v1"

# Primary Database (PostgreSQL)
# Local macOS Homebrew PostgreSQL default:
DATABASE_URL=postgresql+asyncpg://pvsairamsaketh@localhost:5432/project_manager
# Docker Compose PostgreSQL alternative:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/project_manager

# ChromaDB Vector Store Directory (for local semantic search)
CHROMA_PERSIST_DIR="./chroma_data"

# GitHub REST API Token (Optional: increases API rate limits for private or frequent analysis)
GITHUB_TOKEN=

# AI Model Configuration (Optional: system works 100% out of the box with deterministic rules)
OPENAI_API_KEY=
OLLAMA_BASE_URL="http://localhost:11434"

# LangSmith Observability & Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="personal-project-manager"

# Local Project Runner Directory on macOS (for cloning and executing repositories)
LOCAL_PROJECTS_DIR="/Users/pvsairamsaketh/Documents/projects_local"
